class Solution {
public:
    int minimumPushes(string word) {
        int n=word.size();
        int ans=0,a=0;
        while(n>8){
            a++;
            ans+=8*a;
            n-=8;
        }
        a++;
        ans+=(n*a);
        return ans;
    }
};
