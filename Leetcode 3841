class Solution {
    struct Fenwick {
        int n;
        vector<int> bit;

        Fenwick(int n) {
            this->n = n;
            bit.assign(n + 1, 0);
        }

        void add(int idx, int val) {
            for (idx++; idx <= n; idx += idx & -idx) {
                bit[idx] ^= val;
            }
        }

        int query(int idx) {
            int res = 0;
            for (idx++; idx > 0; idx -= idx & -idx) {
                res ^= bit[idx];
            }
            return res;
        }

        void rangeXor(int l, int r, int val) {
            add(l, val);
            if (r + 1 < n) {
                add(r + 1, val);
            }
        }
    };

public:
    vector<bool> palindromePath(int n, vector<vector<int>>& edges, string s, vector<string>& queries) {
        int LOG = 1;
        while ((1LL << LOG) <= n) LOG++;

        vector<vector<int>> adj(n);
        for (auto& e : edges) {
            adj[e[0]].push_back(e[1]);
            adj[e[1]].push_back(e[0]);
        }

        vector<vector<int>> up(LOG, vector<int>(n));
        vector<int> depth(n), tin(n), tout(n), pref(n);
        int timer = 0;

        vector<tuple<int, int, int>> st;
        st.push_back({0, -1, 0});

        while (!st.empty()) {
            auto [u, p, state] = st.back();
            st.pop_back();

            if (state == 1) {
                tout[u] = timer - 1;
                continue;
            }

            tin[u] = timer++;
            up[0][u] = (p == -1 ? u : p);
            depth[u] = (p == -1 ? 0 : depth[p] + 1);

            pref[u] = (p == -1 ? 0 : pref[p]) ^ (1 << (s[u] - 'a'));

            st.push_back({u, p, 1});

            for (int i = (int)adj[u].size() - 1; i >= 0; i--) {
                int v = adj[u][i];
                if (v == p) continue;
                st.push_back({v, u, 0});
            }
        }

        for (int k = 1; k < LOG; k++) {
            for (int u = 0; u < n; u++) {
                up[k][u] = up[k - 1][up[k - 1][u]];
            }
        }

        auto lca = [&](int a, int b) {
            if (depth[a] < depth[b]) swap(a, b);

            int d = depth[a] - depth[b];

            for (int k = 0; k < LOG; k++) {
                if (d & (1 << k)) {
                    a = up[k][a];
                }
            }

            if (a == b) return a;

            for (int k = LOG - 1; k >= 0; k--) {
                if (up[k][a] != up[k][b]) {
                    a = up[k][a];
                    b = up[k][b];
                }
            }

            return up[0][a];
        };

        Fenwick bit(n);
        vector<bool> ans;

        for (string& q : queries) {
            stringstream ss(q);
            string type;
            int u;

            ss >> type >> u;

            if (type == "update") {
                char c;
                ss >> c;

                int delta = (1 << (s[u] - 'a')) ^ (1 << (c - 'a'));

                bit.rangeXor(tin[u], tout[u], delta);
                s[u] = c;
            } else {
                int v;
                ss >> v;

                int w = lca(u, v);

                int a = pref[u] ^ bit.query(tin[u]);
                int b = pref[v] ^ bit.query(tin[v]);

                int mask = a ^ b ^ (1 << (s[w] - 'a'));

                ans.push_back((mask & (mask - 1)) == 0);
            }
        }

        return ans;
    }
};
