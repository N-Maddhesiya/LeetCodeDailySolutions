class Solution {
public:
    int minimumChanges(string s, int k) {
        int n = s.size();
        const int INF = 1e9;
        vector<vector<int>> cost(n, vector<int>(n, 0));
        for(int i = 0; i < n; i++) {
            for(int j = i + 1; j < n; j++) {
                int len = j - i + 1;
                int best = INF;
                for(int d = 1; d < len; d++) {
                    if(len % d != 0)
                        continue;
                    int cnt = 0;
                    for(int x = 0; x < d; x++) {
                        int l = i + x;
                        int r = j - d + 1 + x;
                        while(l < r) {
                            if(s[l] != s[r])
                                cnt++;
                            l += d;
                            r -= d;
                        }
                    }
                    best = min(best, cnt);
                }
                cost[i][j] = best;
            }
        }
        vector<vector<int>> dp(n + 1, vector<int>(k + 1, INF));
        dp[n][0] = 0;
        for(int i = n - 1; i >= 0; i--) {
            for(int p = 1; p <= k; p++) {
                for(int j = i + 1; j < n; j++) {
                    if(dp[j + 1][p - 1] == INF)
                        continue;
                    dp[i][p] = min(dp[i][p],
                        cost[i][j] + dp[j + 1][p - 1]);
                }
            }
        }
        return dp[0][k];
    }
};
