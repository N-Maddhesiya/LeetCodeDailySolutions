class Solution {
public:
    int maxProduct(int n) {
        int ma=n%10;
        int mi=n%10;
        vector<int>ans;
        while(n){
            int r=n%10;
            ans.push_back(r);
            n/=10;
        }
        sort(ans.begin(),ans.end());
        int s=ans.size();
        return ans[s-1]*ans[s-2];
    }
};
