class Solution {
public:
    vector<int> suf;
    vector<vector<int>> dp;
    int n;
    int dfs(int i, int m) {
        if (i >= n) return 0;
        if (i + 2 * m >= n) return suf[i];
        if (dp[i][m] != -1) return dp[i][m];
        int ans = 0;
        for (int x = 1; x <= 2 * m; x++) {
            ans = max(ans, suf[i] - dfs(i + x, max(m, x)));
        }
        return dp[i][m] = ans;
    }
    int stoneGameII(vector<int>& piles) {
        n = piles.size();
        suf.assign(n + 1, 0);
        for (int i = n - 1; i >= 0; i--) {
            suf[i] = suf[i + 1] + piles[i];
        }
        dp.assign(n, vector<int>(n + 1, -1));
        return dfs(0, 1);
    }
};
