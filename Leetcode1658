class Solution {
public:
    int minOperations(vector<int>& nums,int x) {
        int n=nums.size(),sum=0;
        for(int a:nums) sum+=a;
        int t=sum-x;
        if(t<0) return -1;
        if(t==0) return n;
        int l=0,s=0,m=-1;
        for(int r=0;r<n;r++){
            s+=nums[r];
            while(s>t)  s-=nums[l++];
            if(s==t)    m=max(m,r-l+1);
        }
        return m==-1?-1:n-m;
    }
};
