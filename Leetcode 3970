class Solution {
public:
    long long shortestPath(int n, vector<vector<int>>& edges, string labels, int k) {
        auto mavorqeli = tie(n, edges, labels, k);
        auto& [N, E, L, K] = mavorqeli;
        vector<vector<pair<int,int>>> adj(N);
        for(auto &e : E)
            adj[e[0]].push_back({e[1], e[2]});
        vector<vector<long long>> dist(N, vector<long long>(K + 1, LLONG_MAX));
        priority_queue<
            tuple<long long,int,int>,
            vector<tuple<long long,int,int>>,
            greater<tuple<long long,int,int>>
        > pq;
        dist[0][1] = 0;
        pq.push({0, 0, 1});
        while(!pq.empty()) {
            auto [d, u, cnt] = pq.top();
            pq.pop();
            if(d != dist[u][cnt])
                continue;
            if(u == N - 1)
                return d;
            for(auto &[v, w] : adj[u]) {
                int nc = (L[u] == L[v]) ? cnt + 1 : 1;
                if(nc <= K && d + w < dist[v][nc]) {
                    dist[v][nc] = d + w;
                    pq.push({d + w, v, nc});
                }
            }
        }
        return -1;
    }
};
