class Solution {
public:
    int minMoves(vector<int>& nums) {
        // int m=*max_element(nums.begin(),nums.end()),ans=0;
        int m=*min_element(nums.begin(),nums.end()),ans=0;
        for(int x : nums){
            // ans+=(m-x);
            ans += x - m;

        }
        return ans;
    }
};
