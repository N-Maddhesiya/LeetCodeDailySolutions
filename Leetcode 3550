class Solution {
public:
    int smallestIndex(vector<int>& nums) {
        int n=nums.size();
        for(int i=0;i<n;i++){
            int a=Sum(nums[i]);
            if(a==i)    return i;
        }
        return -1;
    }
    int Sum(int x){
        int sum=0;
        while(x){
            int r=x%10;
            sum+=r;
            x/=10;
        }
        return sum;
    }
};
