class Solution {
public:
    int numOfSubarrays(vector<int>& arr) {
        long long even = 1, odd = 0, ans = 0;
        int parity = 0;
        int mod = 1e9 + 7;
        for(int x : arr) {
            parity ^= (x & 1);
            if(parity) {
                ans += even;
                odd++;
            }
            else {
                ans += odd;
                even++;
            }
            ans %= mod;
        }
        return ans;
    }
};
