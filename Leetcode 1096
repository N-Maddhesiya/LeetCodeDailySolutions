class Solution {
public:
    set<string> solve(string &s,int &i) {
        set<string> res,cur={""};
        while(i<s.size()&&s[i]!='}') {
            if(s[i]==',') {
                res.insert(cur.begin(),cur.end());
                cur={""};
                i++;
            }
            else {
                set<string> p;
                if(s[i]=='{') {
                    i++;
                    p=solve(s,i);
                    i++;
                }
                else {
                    p.insert(string(1,s[i]));
                    i++;
                }
                set<string> next;
                for(auto &a:cur)
                    for(auto &b:p)
                        next.insert(a+b);
                cur=next;
            }
        }
        res.insert(cur.begin(),cur.end());
        return res;
    }
    vector<string> braceExpansionII(string expression) {
        int i=0;
        set<string> s=solve(expression,i);
        return vector<string>(s.begin(),s.end());
    }
};
