class Solution {
public:
    int countCommas(int n) {
        long long ans=0;
        long long d=1000;
        int c=1;
        while(d<=n){
            long long u=min<long long>(n,d*1000-1);
            ans+=(u-d+1)*1LL*c;
            d*=1000;
            c++;
            
        }
        return (int)ans;
    }
};
