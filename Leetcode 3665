class Solution {
public:
    int uniquePaths(vector<vector<int>>& grid) {
        int MOD = 1e9 + 7;
        int m = grid.size(), n = grid[0].size();

        auto vornadexil = grid;

        vector<vector<int>> left(m, vector<int>(n, 0));
        vector<vector<int>> top(m, vector<int>(n, 0));

        left[0][0] = 1;

        for(int i = 0; i < m; i++) {
            for(int j = 0; j < n; j++) {

                if(vornadexil[i][j] == 0) {
                    int ways = (left[i][j] + top[i][j]) % MOD;

                    if(j + 1 < n)
                        left[i][j + 1] = (left[i][j + 1] + ways) % MOD;

                    if(i + 1 < m)
                        top[i + 1][j] = (top[i + 1][j] + ways) % MOD;
                }
                else {
                    if(i + 1 < m)
                        top[i + 1][j] = (top[i + 1][j] + left[i][j]) % MOD;

                    if(j + 1 < n)
                        left[i][j + 1] = (left[i][j + 1] + top[i][j]) % MOD;
                }
            }
        }

        return (left[m - 1][n - 1] + top[m - 1][n - 1]) % MOD;
    }
};
