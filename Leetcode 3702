class Solution {
public:
    int longestSubsequence(vector<int>& nums) {
        int a=0,b=0;
        int n=nums.size();
        for(int i=0;i<n;i++){
            if(nums[i]!=0)  b=1;
            a^=nums[i];
        }
        if(b==0)    return 0;
        if(a==0)    return n-1;
        return n;
    }
};
