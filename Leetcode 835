class Solution {
public:
    int largestOverlap(vector<vector<int>>& img1, vector<vector<int>>& img2) {
        int n = img1.size();
        int ans = 0;
        for (int dx = -(n - 1); dx <= n - 1; dx++) {
            for (int dy = -(n - 1); dy <= n - 1; dy++) {
                int cnt = 0;
                for (int i = 0; i < n; i++) {
                    for (int j = 0; j < n; j++) {
                        if (img1[i][j] == 0)
                            continue;
                        int r = i + dx;
                        int c = j + dy;
                        if (r >= 0 && r < n && c >= 0 && c < n &&
                            img2[r][c] == 1) {
                            cnt++;
                        }
                    }
                }
                ans = max(ans, cnt);
            }
        }
        return ans;
    }
};
