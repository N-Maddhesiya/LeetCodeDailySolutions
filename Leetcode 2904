class Solution {
public:
    string shortestBeautifulSubstring(string s, int k) {
        vector<int> pos;
        for(int i=0;i<s.size();i++)
            if(s[i]=='1') pos.push_back(i);
        if(pos.size()<k) return "";
        string ans="";
        int mn=1e9;
        for(int i=0;i+k-1<pos.size();i++){
            int l=pos[i];
            int r=pos[i+k-1];
            int len=r-l+1;
            if(len<mn){
                mn=len;
                ans=s.substr(l,len);
            }
            else if(len==mn){
                string cur=s.substr(l,len);
                if(cur<ans) ans=cur;
            }
        }
        return ans;
    }
};
