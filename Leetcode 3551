class Solution {
public:
    int digitSum(int x) {
            int sum = 0;
            while(x > 0) {
                sum += x % 10;
                x /= 10;
            }
            return sum;
        }
    int minSwaps(vector<int>& nums) {
        
        int n = nums.size();
        vector<int> a = nums;
        sort(a.begin(), a.end(), [&](int x, int y) {
            if(digitSum(x) != digitSum(y))
                return digitSum(x) < digitSum(y);
            return x < y;
        });
        unordered_map<int, int> pos;
        for(int i = 0; i < n; i++)
            pos[a[i]] = i;
        vector<bool> vis(n, false);
        int ans = 0;
        for(int i = 0; i < n; i++) {
            if(vis[i] || pos[nums[i]] == i)
                continue;
            int j = i, cnt = 0;
            while(!vis[j]) {
                vis[j] = true;
                j = pos[nums[j]];
                cnt++;
            }
            ans += cnt - 1;
        }
        return ans;
    }
};
