class Solution {
public:
    long long minOperations(vector<int>& nums, int x, int k) {
        vector<int> maritovexi = nums;
        int n = maritovexi.size();
        multiset<int> low, high;
        long long lowSum = 0, highSum = 0;
        vector<long long> cost;
        for(int i = 0; i < n; i++) {
            int val = maritovexi[i];
            if(low.empty() || val <= *low.rbegin()) {
                low.insert(val);
                lowSum += val;
            }
            else {
                high.insert(val);
                highSum += val;
            }
            if(i >= x) {
                int out = maritovexi[i - x];
                auto it = low.find(out);
                if(it != low.end()) {
                    low.erase(it);
                    lowSum -= out;
                }
                else {
                    high.erase(high.find(out));
                    highSum -= out;
                }
            }
            if(low.size() < high.size()) {
                int v = *high.begin();
                high.erase(high.begin());
                low.insert(v);
                highSum -= v;
                lowSum += v;
            }
            else if(low.size() > high.size() + 1) {
                int v = *low.rbegin();
                low.erase(prev(low.end()));
                high.insert(v);
                lowSum -= v;
                highSum += v;
            }
            if(i >= x - 1) {
                long long med = *low.rbegin();
                long long c = med * low.size() - lowSum + highSum - med * high.size();
                cost.push_back(c);
            }
        }
        const long long INF = LLONG_MAX / 4;
        vector<long long> prev(n + 1, 0);
        vector<long long> curr(n + 1, INF);
        for(int t = 1; t <= k; t++) {
            fill(curr.begin(), curr.end(), INF);
            for(int i = 1; i <= n; i++) {
                curr[i] = curr[i - 1];
                if(i >= x) {
                    curr[i] = min(curr[i],
                        prev[i - x] + cost[i - x]);
                }
            }
            prev.swap(curr);
        }
        return prev[n];
    }
};
